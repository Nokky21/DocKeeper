---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  title?: string;
}
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const { title = "DocKeeper — documentation that doesn't rot" } = Astro.props;
const description =
  "DocKeeper anchors every claim in your docs to the code behind it and tells you when that code changes. " +
  "An Agent Skill for Claude Code, Codex, Gemini CLI, Cursor and Copilot, plus a zero-dependency CLI for CI.";
const repo = "https://github.com/Nokky21/DocKeeper";
const url = new URL(base, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#08090a">
  <link rel="canonical" href={url}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={url}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content="Anchor every claim to its code. Seal it. Check it on every pull request. Free, local, zero dependencies.">
  <meta property="og:image" content={`${url}og.png`}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav">
    <div class="wrap">
      <a class="brand" href={base} aria-label="DocKeeper home">
        <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="var(--accent)"></rect><path d="M9 16.5l4.5 4.5L23 11.5" stroke="var(--accent-ink)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        DocKeeper
      </a>
      <nav aria-label="Main">
        <a class="link" href={`${base}#demo`}>Demo</a>
        <a class="link" href={`${base}#how`}>How it works</a>
        <a class="link" href={`${base}#install`}>Install</a>
        <a class="link" href={`${base}#faq`}>FAQ</a>
        <a class="btn btn-ghost btn-sm" href={repo}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <span>DocKeeper · MIT license · No account, no network, no tracking.</span>
      <nav aria-label="Footer">
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases/latest`}>Releases</a>
        <a href={`${repo}/blob/main/SKILL.md`}>SKILL.md</a>
        <a href={`${repo}/blob/main/SPEC.md`}>Spec (ES)</a>
      </nav>
    </div>
  </footer>

  <script>
    document.documentElement.classList.add("js");

    // Pestañas: sin JS se ven todos los paneles.
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const activar = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const activo = t === tab;
        t.setAttribute("aria-selected", String(activo));
        t.tabIndex = activo ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !activo;
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => activar(t));
      t.addEventListener("keydown", (e) => {
        const paso = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!paso) return;
        const siguiente = tabs[(i + paso + tabs.length) % tabs.length];
        activar(siguiente);
        siguiente.focus();
      });
    });
    if (tabs.length) activar(tabs[0]);

    // Copiar comandos sin el prompt.
    for (const boton of document.querySelectorAll<HTMLButtonElement>(".copy")) {
      boton.addEventListener("click", async () => {
        const pre = boton.parentElement?.querySelector("pre")?.cloneNode(true) as HTMLElement | undefined;
        if (!pre) return;
        pre.querySelectorAll(".p").forEach((p) => p.remove());
        try {
          await navigator.clipboard.writeText(pre.textContent?.trim() ?? "");
          boton.textContent = "Copied";
          boton.dataset.done = "";
          setTimeout(() => { boton.textContent = "Copy"; delete boton.dataset.done; }, 1600);
        } catch {
          boton.textContent = "Select and copy";
        }
      });
    }

    // Entrada suave al hacer scroll.
    const observador = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) { e.target.classList.add("in"); observador.unobserve(e.target); }
    }, { rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll("[data-reveal]").forEach((el) => observador.observe(el));

    // Foco de luz que sigue al cursor en las teselas.
    for (const tesela of document.querySelectorAll<HTMLElement>(".tile")) {
      tesela.addEventListener("pointermove", (e) => {
        const r = tesela.getBoundingClientRect();
        tesela.style.setProperty("--x", `${e.clientX - r.left}px`);
        tesela.style.setProperty("--y", `${e.clientY - r.top}px`);
      });
    }
  </script>
</body>
</html>
