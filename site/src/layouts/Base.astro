---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/newsreader/opsz.css";
import "../styles/global.css";

interface Props {
  title?: string;
}
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const { title = "DocKeeper — documentation that doesn't rot" } = Astro.props;
const description =
  "Your coding agent writes the docs, diagrams included. DocKeeper ties every claim and every diagram to the " +
  "code behind it and tells you when that code changes. An Agent Skill plus a zero-dependency CLI for CI.";
const repo = "https://github.com/Nokky21/DocKeeper";
const idiomas = [["English", "README.md"], ["Español", "docs/i18n/README.es.md"], ["Português", "docs/i18n/README.pt-BR.md"], ["Français", "docs/i18n/README.fr.md"], ["Deutsch", "docs/i18n/README.de.md"], ["Italiano", "docs/i18n/README.it.md"], ["Nederlands", "docs/i18n/README.nl.md"], ["Polski", "docs/i18n/README.pl.md"], ["Čeština", "docs/i18n/README.cs.md"], ["Svenska", "docs/i18n/README.sv.md"], ["Русский", "docs/i18n/README.ru.md"], ["Українська", "docs/i18n/README.uk.md"], ["Türkçe", "docs/i18n/README.tr.md"], ["العربية", "docs/i18n/README.ar.md"], ["עברית", "docs/i18n/README.he.md"], ["हिन्दी", "docs/i18n/README.hi.md"], ["简体中文", "docs/i18n/README.zh-CN.md"], ["繁體中文", "docs/i18n/README.zh-TW.md"], ["日本語", "docs/i18n/README.ja.md"], ["한국어", "docs/i18n/README.ko.md"], ["Tiếng Việt", "docs/i18n/README.vi.md"], ["Bahasa Indonesia", "docs/i18n/README.id.md"], ["ไทย", "docs/i18n/README.th.md"]];
const url = new URL(base, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#151412" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href={url}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={url}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content="Your agent writes the docs and the diagrams; DocKeeper keeps every claim tied to its code and checked on every commit. Free, local, zero dependencies.">
  <meta property="og:image" content={`${url}og.png`}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="page">
      <a class="brand" href={base} aria-label="DocKeeper home">DocKeeper <small>v0.4</small></a>
      <nav aria-label="Main">
        <a class="opt" href={`${base}#writes`}>What it writes</a>
        <a class="opt" href={`${base}#diagrams`}>Diagrams</a>
        <a class="opt" href={`${base}#demo`}>Demo</a>
        <a href={`${base}#install`}>Install</a>
        <a href={repo}>GitHub</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="page colophon">
      <div class="colo-brand">
        <p class="brand">DocKeeper <small>v0.4</small></p>
        <p class="motto">Documentation that doesn't rot.</p>
        <p>MIT license. No account, no network, no tracking. This page loads no third-party scripts or fonts.</p>
      </div>
      <nav aria-label="Project">
        <b>Project</b>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases/latest`}>Releases</a>
        <a href={`${repo}/blob/main/SKILL.md`}>SKILL.md</a>
        <a href={`${repo}/blob/main/SPEC.md`}>Spec (Spanish)</a>
      </nav>
      <nav aria-label="Docs">
        <b>Docs</b>
        <a href={`${repo}/blob/main/docs/install.md`}>Install guide</a>
        <a href={`${repo}/blob/main/docs/reference.md`}>Reference</a>
        <a href={`${repo}/blob/main/docs/architecture.md`}>Architecture</a>
      </nav>
      <nav class="langs" aria-label="README in other languages">
        <b>README in</b>
        <div>{idiomas.map(([nombre, ruta]) => <a href={`${repo}/blob/main/${ruta}`} dir="auto">{nombre}</a>)}</div>
      </nav>
    </div>
    <div class="page"><p class="set">Set in Newsreader and Geist.</p></div>
  </footer>

  <script>
    document.documentElement.classList.add("js");

    // Pestañas: sin JS se ven todos los paneles.
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const activar = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const activo = t === tab;
        t.setAttribute("aria-selected", String(activo));
        t.tabIndex = activo ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !activo;
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => activar(t));
      t.addEventListener("keydown", (e) => {
        const paso = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!paso) return;
        const siguiente = tabs[(i + paso + tabs.length) % tabs.length];
        activar(siguiente);
        siguiente.focus();
      });
    });
    if (tabs.length) activar(tabs[0]);

    // Copiar comandos sin el prompt.
    for (const boton of document.querySelectorAll<HTMLButtonElement>(".copy")) {
      boton.addEventListener("click", async () => {
        const pre = boton.parentElement?.querySelector("pre")?.cloneNode(true) as HTMLElement | undefined;
        if (!pre) return;
        pre.querySelectorAll(".p").forEach((p) => p.remove());
        try {
          await navigator.clipboard.writeText(pre.textContent?.trim() ?? "");
          boton.textContent = "Copied";
          boton.dataset.done = "";
          setTimeout(() => { boton.textContent = "Copy"; delete boton.dataset.done; }, 1600);
        } catch {
          boton.textContent = "Select and copy";
        }
      });
    }

    // Comandos y terminales que no caben: fundido en el borde mientras quede algo por ver.
    const anchos = Array.from(document.querySelectorAll<HTMLElement>(".cmd pre, .window-foot .term"));
    const medir = (el: HTMLElement) => {
      const marca = el.classList.contains("term") ? el.parentElement : el;
      marca?.toggleAttribute("data-more", el.scrollLeft + el.clientWidth < el.scrollWidth - 2);
    };
    const observador = new ResizeObserver((cambios) => cambios.forEach((c) => medir(c.target as HTMLElement)));
    for (const el of anchos) {
      el.addEventListener("scroll", () => medir(el), { passive: true });
      observador.observe(el);
    }
    document.fonts?.ready.then(() => anchos.forEach(medir));

    // Índice lateral: aparece al dejar atrás el héroe y marca la sección que se está leyendo.
    const indice = document.querySelector<HTMLElement>(".onpage");
    if (indice) {
      const enlaces = Array.from(indice.querySelectorAll<HTMLAnchorElement>("a"));
      const secciones = enlaces.map((a) => document.getElementById(a.hash.slice(1)));
      let pendiente = false;
      const actualizar = () => {
        pendiente = false;
        const linea = innerHeight * 0.35;
        let actual = -1;
        secciones.forEach((s, i) => { if (s && s.getBoundingClientRect().top <= linea) actual = i; });
        indice.toggleAttribute("data-on", actual >= 0);
        enlaces.forEach((a, i) => (i === actual ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current")));
      };
      addEventListener("scroll", () => { if (!pendiente) { pendiente = true; requestAnimationFrame(actualizar); } }, { passive: true });
      actualizar();
    }

  </script>
</body>
</html>
