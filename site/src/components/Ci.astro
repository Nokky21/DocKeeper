<section id="ci">
  <div class="wrap">
    <p class="eyebrow">Continuous integration</p>
    <h2>Keep it true on every pull request.</h2>
    <p class="lead">The repository is also a GitHub Action. Anywhere else, it is two lines of shell.</p>
    <div class="two">
<pre class="code"><span class="c"># .github/workflows/docs.yml</span>
<span class="k">name:</span> docs
<span class="k">on:</span> [push, pull_request]
<span class="k">jobs:</span>
  <span class="k">dockeeper:</span>
    <span class="k">runs-on:</span> ubuntu-latest
    <span class="k">steps:</span>
      - <span class="k">uses:</span> <span class="s">actions/checkout@v6</span>
      - <span class="k">uses:</span> <span class="s">Nokky21/DocKeeper@v0.1.0</span></pre>
<pre class="code"><span class="c"># any other CI</span>
git clone --depth 1 \
  https://github.com/Nokky21/DocKeeper.git /tmp/dk
python3 /tmp/dk/bin/dockeeper check

<span class="c"># narrow it to one part of the repo</span>
python3 /tmp/dk/bin/dockeeper check --solo src/payments</pre>
    </div>
    <!-- dockeeper: dockeeper/alcance.py#Alcance dockeeper/motor.py#FALLOS -->
  </div>
</section>
