---
const pasos = [
  ["1 · audit", "Find the gaps", "Missing pages, docs without anchors, the biggest undocumented code."],
  ["2 · write", "Write from templates", "README, architecture, decisions, runbooks, API, onboarding."],
  ["3 · scan", "Seal and confirm", "Reads the block each anchor landed on and fixes anchors that point at the wrong code."],
  ["4 · check", "Verify", "The exit code decides. No green when nothing was checked."],
  ["5 · fix", "Repair", "Moved code is automatic. Changed code means rewriting the claim first."],
];
---
<section id="loop">
  <div class="wrap">
    <p class="eyebrow">What your agent does</p>
    <h2>The same loop, every time.</h2>
    <p class="lead">The skill gives your agent one rule, every verifiable claim gets an anchor, and one workflow it can't skip.</p>
    <div class="loop">
      {pasos.map(([orden, titulo, texto]) => <div><span>{orden}</span><b>{titulo}</b><p>{texto}</p></div>)}
    </div>
    <!-- dockeeper: dockeeper/motor.py#comprobar -->
  </div>
</section>
