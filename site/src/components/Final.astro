---
import Cmd from "./Cmd.astro";

const repo = "https://github.com/Nokky21/DocKeeper";
---
<section class="section final">
  <div class="wrap" data-reveal>
    <h2 class="h2">Make every claim in your docs provable.</h2>
    <p class="lead">Install it once, then ask your agent to document the repository.</p>
    <Cmd cmd="git clone https://github.com/Nokky21/DocKeeper.git ~/.claude/skills/dockeeper" />
    <div class="ctas">
      <a class="btn btn-primary" href={repo}>Star it on GitHub</a>
      <a class="textlink" href={`${repo}#readme`}>Read the docs <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
