---
const hechos = [
  ["No account, no server.", "It runs where your code is: your machine or your CI."],
  ["No network.", "Your code never leaves the machine. The seal stores hashes, not code."],
  ["No AI in the check.", "The agent writes. DocKeeper verifies, the same way every time."],
  ["No dependencies.", "Python standard library only. The folder is the whole install."],
  ["The whole engine, MIT.", "Every check is in the open-source version."],
  ["It checks itself.", "Its README in 23 languages, every page of its docs and this page are sealed. CI fails if they stop being true, on Linux, macOS and Windows."],
];
const limites = [
  "It compares content, not meaning: a block rewritten with the same behaviour is reported as <code>CHANGED</code>.",
  "Copies that are not contiguous go unnoticed, and copies of one or two lines are allowed on purpose.",
  "Definitions are found with patterns, not a parser. Rare constructs fall back to the enclosing definition, and <code>scan</code> shows every block so you can confirm it.",
  "It checks that documentation is still <em>true</em>, not that it is <em>useful</em>.",
];
---
<section class="sec" id="principles" aria-labelledby="t-principles">
  <h2 id="t-principles"><span class="n">9</span> Free, local, and honest about its limits</h2>
  <div class="wide two">
    <div>
      <h3>What you get</h3>
      <ul class="list">
        {hechos.map(([titulo, texto]) => <li><b>{titulo}</b> {texto}</li>)}
      </ul>
      <!-- dockeeper: dockeeper/sello.py#Entrada dockeeper/huellas.py#huella bin/dockeeper:7 tests/test_autocomprobacion.py#PruebasAutocomprobacion.test_el_repositorio_se_mantiene_limpio .github/workflows/ci.yml:19 -->
    </div>
    <div>
      <h3>What it won't do</h3>
      <ul class="list">
        {limites.map((l) => <li set:html={l} />)}
      </ul>
      <!-- dockeeper: dockeeper/huellas.py#normalizar dockeeper/publicado.py#IndiceCopias dockeeper/bloques.py#Analisis -->
    </div>
  </div>
</section>
